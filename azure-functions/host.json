{
  "version": "2.0",
  "functionTimeout": "00:05:00",
  "concurrency": {"dynamicConcurrencyEnabled": false},
  "extensions": {
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:01:00",
      "maxPollingInterval": "00:00:15",
      "messageEncoding": "base64"
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "logging": {
    "logLevel": {"default": "Information", "Host.Results": "Information"},
    "applicationInsights": {"samplingSettings": {"isEnabled": false}}
  }
}
